#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "base_layer";
            bindings = <
                &kp ESC   &kp N1   &kp N2   &kp N3    &kp N4   &kp N5     &kp N6   &kp N7   &kp N8    &kp N9   &kp N0    &kp BSPC
                &kp TAB   &kp Q    &kp W    &kp E     &kp R    &kp T      &kp Y    &kp U    &kp I     &kp O    &kp P     &kp BSLH
                &kp CAPS  &kp A    &kp S    &kp D     &kp F    &kp G      &kp H    &kp J    &kp K     &kp L    &kp SEMI  &kp QUOT
                &kp LSFT  &kp Z    &kp X    &kp C     &kp V    &kp B      &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH  &kp RSFT
                           &kp LCTL &kp LGUI &kp LALT  &kp SPC             &kp SPC  &kp RALT &kp RGUI  &kp RCTL
            >;
        };

        layer2 {
            display-name = "layer2";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                       &trans &trans &trans &trans           &trans &trans &trans &trans
            >;
        };

        layer3 {
            display-name = "layer3";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                       &trans &trans &trans &trans           &trans &trans &trans &trans
            >;
        };

        layer4 {
            display-name = "layer4";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                       &trans &trans &trans &trans           &trans &trans &trans &trans
            >;
        };

        layer5 {
            display-name = "layer5";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                       &trans &trans &trans &trans           &trans &trans &trans &trans
            >;
        };

        layer6 {
            display-name = "layer6";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                       &trans &trans &trans &trans           &trans &trans &trans &trans
            >;
        };
    };
};
