/*
 * Totem Max — default keymap
 *
 * Layer 0: Base (QWERTY)
 * Layer 1: Navigation & media
 * Layers 2-5: Transparent
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        label = "Totem_Max";

        /* ─── Layer 0: Base ─── */
        default_layer {
            display-name = "Base";
            bindings = <
    /* Left half */                              /* Right half */
    &kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5    &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
    &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T     &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSLH
    &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G     &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp QUOT
    &kp LSFT  &kp Z  &kp X  &kp C  &kp V  &kp B     &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSFT
               &kp LCTL &kp LGUI &kp LALT &kp SPC   &kp SPC &kp RALT &kp RGUI &kp RCTL
            >;
        };

        /* ─── Layer 1 ─── */
        layer_1 {
            display-name = "Nav";
            bindings = <
    &trans    &trans    &trans    &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans    &trans
    &trans    &trans    &trans    &trans    &trans    &trans      &trans    &trans    &kp UP    &trans    &trans    &trans
    &trans    &trans    &trans    &trans    &trans    &trans      &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans    &trans
    &trans    &trans    &trans    &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans    &trans
               &trans    &trans    &trans    &trans                 &trans    &trans    &trans    &trans
            >;
        };

        /* ─── Layer 2 ─── */
        layer_2 {
            display-name = "BT";
            bindings = <
    &bt BT_CLR  &trans     &trans     &trans     &trans     &trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans      &trans
    &trans      &trans     &trans     &trans     &trans     &trans       &trans        &trans        &trans        &trans        &trans      &trans
    &trans      &trans     &trans     &trans     &trans     &trans       &trans        &trans        &trans        &trans        &trans      &trans
    &trans      &trans     &trans     &trans     &trans     &trans       &trans        &trans        &trans        &trans        &trans      &trans
                &trans     &trans     &trans     &trans                    &trans        &trans        &trans        &trans
            >;
        };

        /* ─── Layer 3 ─── */
        layer_3 {
            display-name = "L3";
            bindings = <
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans          &trans &trans &trans &trans
            >;
        };

        /* ─── Layer 4 ─── */
        layer_4 {
            display-name = "L4";
            bindings = <
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans          &trans &trans &trans &trans
            >;
        };

        /* ─── Layer 5 ─── */
        layer_5 {
            display-name = "L5";
            bindings = <
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans          &trans &trans &trans &trans
            >;
        };
    };
};
