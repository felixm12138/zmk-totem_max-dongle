/*
 * Totem Max — dongle overlay
 *
 * The dongle has no physical keys. It uses zmk,physical-layout
 * instead of zmk,matrix-transform in chosen to enable ZMK Studio.
 * Display/pinctrl are provided by prospector_adapter shield.
 */

#include "totem_max.dtsi"

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

&physical_layout0 {
    kscan = <&mock_kscan>;
};
